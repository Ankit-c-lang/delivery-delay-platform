# Copy to .env and edit. .env is gitignored; .env.example is committed.
#   cp .env.example .env
#
# Host ports bind to 127.0.0.1 only — nothing here is exposed to the LAN.

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=delay
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=delay

# Where application code reaches Postgres.
#   on the host (the normal case):   POSTGRES_HOST=127.0.0.1
#   from inside a Compose service:   POSTGRES_HOST=postgres  (set by docker-compose.yml)
POSTGRES_HOST=127.0.0.1

# Published host port AND the port host-side code connects to. The container always
# listens on 5432 internally; change this only if 5432 is taken on the host.
POSTGRES_PORT=5432

# --- MLflow -------------------------------------------------------------------
# The tracking server's HTTP endpoint. Clients (training, promotion, the API) talk to
# this URI; only the mlflow container itself touches the SQLite backend store.
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- API ----------------------------------------------------------------------
# 8001, not 8000: port 8000 belongs to the realtime-fraud-detection project on this
# machine (CLAUDE.md invariant 10). Container-internal stays 8000.
API_PORT=8001
